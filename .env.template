# =============================================================================
# BrainMap Backend (Claude SDK) - Environment Configuration
# =============================================================================
# Copy to .env and fill in values

# -----------------------------------------------------------------------------
# Claude API (Required)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Model to use (optional, defaults to claude-sonnet-4-20250514)
CLAUDE_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# Supabase (Required)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJ...

# -----------------------------------------------------------------------------
# Context Management
# -----------------------------------------------------------------------------
# Maximum tokens before session compaction (default: 150000)
MAX_CONTEXT_TOKENS=150000

# Tokens to reserve for response (default: 4000)
RESERVE_RESPONSE_TOKENS=4000

# Tokens to keep after compaction (default: 20000)
KEEP_RECENT_TOKENS=20000

# -----------------------------------------------------------------------------
# Memory System
# -----------------------------------------------------------------------------
# Directory for memory files (default: ./memory_store)
MEMORY_DIR=./memory_store

# Vector search provider: openai, local, none (default: openai)
EMBEDDING_PROVIDER=openai

# OpenAI API key (for embeddings if using openai provider)
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Heartbeat / Proactive Features
# -----------------------------------------------------------------------------
# Enable heartbeat checks (default: true)
HEARTBEAT_ENABLED=true

# Heartbeat interval in minutes (default: 30)
HEARTBEAT_INTERVAL_MINUTES=30

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------
# Dev mode skips authentication (default: false)
DEV_MODE=false

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Optional Integrations
# -----------------------------------------------------------------------------
# Notion
NOTION_API_KEY=

# Google Calendar (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
